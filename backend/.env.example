# Local dev (docker-compose): copy to .env and these match docker-compose.yml defaults
DATABASE_URL=postgresql://admin:password123@localhost:5432/turbocompress?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379

# S3_ENDPOINT set -> talk to local MinIO. Unset in production -> real AWS S3,
# credentials resolved from the EC2 instance's IAM role (no keys needed there).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=turbocompress
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
AWS_REGION=ap-south-1

STRIPE_SECRET_KEY=sk_test_...
